# Supabase — copy this file to .env.local (or .env) and fill in the values from
# Supabase Dashboard > Project Settings > API.
#
# Both are safe to expose to the browser: the anon key only grants what the
# row-level security policies in supabase/migrations/ allow.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The canonical site address (used for canonical URLs, the sitemap, social
# images and structured data).
NEXT_PUBLIC_SITE_URL=https://www.ges.lk

# Optional: Google Search Console verification token (the content="…" value of
# the HTML-tag method). Not needed if you verify the domain by DNS instead.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# AI chat agent — SERVER-ONLY secrets. Never prefix these with NEXT_PUBLIC_.
# On Netlify, add them under Site configuration > Environment variables and
# mark them as secret. The chat widget stays hidden until both are set.
# ---------------------------------------------------------------------------

# Supabase Dashboard > Project Settings > API > service_role (secret) key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# platform.openai.com/api-keys — set a monthly spend limit on the account too.
OPENAI_API_KEY=sk-...

# Optional: the OpenAI model (default gpt-4o-mini).
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional: any long random string, used to anonymise visitor IPs for rate limiting.
CHAT_HASH_SALT=change-me-to-a-long-random-string

# Testing only: set to "stub" to run the chat without OpenAI (scripted replies,
# real estimates and CRM writes). Never set this in production.
# CHAT_PROVIDER=stub
